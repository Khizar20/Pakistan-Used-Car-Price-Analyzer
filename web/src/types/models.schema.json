{
  "$defs": {
    "CityPrice": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "City"
        },
        "listing_count": {
          "minimum": 0,
          "title": "Listing Count",
          "type": "integer"
        },
        "lower_quartile_pkr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower Quartile Pkr"
        },
        "make": {
          "title": "Make",
          "type": "string"
        },
        "median_mileage_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Mileage Km"
        },
        "median_price_pkr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Price Pkr"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "model_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Year"
        },
        "observed_through": {
          "title": "Observed Through",
          "type": "string"
        },
        "priced_listing_count": {
          "minimum": 0,
          "title": "Priced Listing Count",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ok",
            "insufficient_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "transmission": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transmission"
        },
        "upper_quartile_pkr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper Quartile Pkr"
        }
      },
      "required": [
        "make",
        "model",
        "city",
        "model_year",
        "transmission",
        "listing_count",
        "priced_listing_count",
        "median_price_pkr",
        "lower_quartile_pkr",
        "upper_quartile_pkr",
        "median_mileage_km",
        "observed_through",
        "status"
      ],
      "title": "CityPrice",
      "type": "object"
    },
    "ModelSummary": {
      "additionalProperties": false,
      "properties": {
        "listing_count": {
          "minimum": 0,
          "title": "Listing Count",
          "type": "integer"
        },
        "make": {
          "title": "Make",
          "type": "string"
        },
        "median_price_pkr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Price Pkr"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "priced_listing_count": {
          "minimum": 0,
          "title": "Priced Listing Count",
          "type": "integer"
        }
      },
      "required": [
        "make",
        "model",
        "listing_count",
        "priced_listing_count",
        "median_price_pkr"
      ],
      "title": "ModelSummary",
      "type": "object"
    },
    "ModelsSummary": {
      "additionalProperties": false,
      "properties": {
        "city_price_parts": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "City Price Parts",
          "type": "array"
        },
        "city_prices": {
          "items": {
            "$ref": "#/$defs/CityPrice"
          },
          "title": "City Prices",
          "type": "array"
        },
        "minimum_city_sample": {
          "default": 5,
          "title": "Minimum City Sample",
          "type": "integer"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelSummary"
          },
          "title": "Models",
          "type": "array"
        },
        "population": {
          "const": "latest_active_nonduplicate",
          "default": "latest_active_nonduplicate",
          "title": "Population",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "status": {
          "enum": [
            "ok",
            "insufficient_data"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "models",
        "city_prices",
        "city_price_parts",
        "minimum_city_sample",
        "population"
      ],
      "title": "ModelsSummary",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/ModelsSummary"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "bundle_id",
    "data"
  ],
  "title": "ModelsExport",
  "type": "object"
}
